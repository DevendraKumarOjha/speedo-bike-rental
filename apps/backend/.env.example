PORT=3002
NODE_ENV=development
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=speedo_bike_rental
# Optional one-time migration source; keep it outside the app directory.
# APP_DATA_FILE=/path/to/legacy-app-data.json
# Set true only for the first startup when importing a legacy JSON file.
APP_IMPORT_LEGACY_DATA=false
SESSION_SECRET=replace-this-for-production
JWT_SECRET=replace-with-a-long-random-secret
SUPER_ADMIN_COMMISSION_RATE=0.10
# Temporary local testing credentials are documented in README.md.
# ADMIN_LOGIN_MOBILE=8888888888
